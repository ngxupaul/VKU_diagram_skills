  <diagram id="p2_project_usecase" name="2. Use Case Diagram WebGIS (Mục 3.1 - Phân quyền)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="840">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- SYSTEM BOUNDARY -->
    <mxCell id="sys_boundary" value="Hệ thống WebGIS &amp; Quản lý Dân cư Lệ Sơn Nam Smart Village" style="shape=swimlane;startSize=34;fillColor=#FFFFFF;strokeColor=#374151;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#111827;align=center;collapsible=0;html=1;" vertex="1" parent="1">
      <mxGeometry x="190" y="30" width="820" height="770" as="geometry"/>
    </mxCell>

    <!-- ACTORS -->
    <!-- User (Left): Only public & summary info -->
    <mxCell id="actor_user" value="Người dùng&#xa;(User / Dân cư / Khách)&#xa;[Chỉ xem thông tin chung]" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.6;fontColor=#111827;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="50" y="190" width="45" height="85" as="geometry"/>
    </mxCell>

    <!-- Admin (Right): Full access to detailed records & GIS management -->
    <mxCell id="actor_admin" value="Cán bộ quản lý&#xa;(Admin / Trưởng thôn)&#xa;[Toàn quyền quản trị]" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.6;fontColor=#111827;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1075" y="390" width="45" height="85" as="geometry"/>
    </mxCell>

    <!-- ZONE 1: PUBLIC / GENERAL USE CASES (User & Admin) -->
    <mxCell id="zone_public" value="Phân vùng Chức năng Công cộng (Thông tin chung đã tổng hợp)" style="swimlane;startSize=24;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=1;dashed=1;fontStyle=2;fontSize=11;fontColor=#4B5563;collapsible=0;html=1;" vertex="1" parent="sys_boundary">
      <mxGeometry x="30" y="45" width="370" height="340" as="geometry"/>
    </mxCell>

    <mxCell id="uc_pub_map" value="Xem bản đồ tổng quan thôn&#xa;(Ranh giới &amp; vị trí chung)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontColor=#111827;fontSize=11.5;fontFamily=Helvetica;" vertex="1" parent="zone_public">
      <mxGeometry x="85" y="35" width="200" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="uc_pub_dash" value="Xem Dashboard thống kê tổng hợp&#xa;(Tổng dân số, cơ cấu giới tính/tuổi)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontColor=#111827;fontSize=11.5;fontFamily=Helvetica;" vertex="1" parent="zone_public">
      <mxGeometry x="85" y="110" width="215" height="52" as="geometry"/>
    </mxCell>

    <mxCell id="uc_pub_agri" value="Xem thống kê tổng quan&#xa;đất đai, cây trồng &amp; vật nuôi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontColor=#111827;fontSize=11.5;fontFamily=Helvetica;" vertex="1" parent="zone_public">
      <mxGeometry x="85" y="185" width="205" height="52" as="geometry"/>
    </mxCell>

    <mxCell id="uc_pub_chat" value="Tra cứu thông tin qua Chatbot AI&#xa;(Chỉ trả lời số liệu đã tổng hợp)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontColor=#111827;fontSize=11.5;fontFamily=Helvetica;" vertex="1" parent="zone_public">
      <mxGeometry x="85" y="260" width="215" height="54" as="geometry"/>
    </mxCell>


    <!-- ZONE 2: ADMIN ONLY - DETAILED & SENSITIVE DATA MANAGEMENT -->
    <mxCell id="zone_admin" value="Phân vùng Quản trị &amp; Dữ liệu Chi tiết (Dành riêng cho Admin)" style="swimlane;startSize=24;fillColor=#F3F4F6;strokeColor=#4B5563;strokeWidth=1.2;fontStyle=1;fontSize=11;fontColor=#111827;collapsible=0;html=1;" vertex="1" parent="sys_boundary">
      <mxGeometry x="430" y="45" width="365" height="705" as="geometry"/>
    </mxCell>

    <!-- Admin Login -->
    <mxCell id="uc_adm_login" value="Đăng nhập quản trị viên&#xa;(Admin Authentication)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontColor=#111827;fontSize=11.5;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="zone_admin">
      <mxGeometry x="90" y="35" width="190" height="50" as="geometry"/>
    </mxCell>

    <!-- Tra cuu chi tiet ho dan -->
    <mxCell id="uc_adm_detail" value="Tra cứu chi tiết từng hộ dân&#xa;(Chủ hộ, số nhân khẩu, CCCD, địa chỉ)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontColor=#111827;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="zone_admin">
      <mxGeometry x="75" y="110" width="225" height="54" as="geometry"/>
    </mxCell>

    <!-- Loc theo to chi tiet -->
    <mxCell id="uc_adm_filter" value="Lọc &amp; quản lý danh sách&#xa;hộ dân theo từng tổ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontColor=#111827;fontSize=11.5;fontFamily=Helvetica;" vertex="1" parent="zone_admin">
      <mxGeometry x="85" y="185" width="205" height="50" as="geometry"/>
    </mxCell>

    <!-- Ve & Chinh sua GeoJSON -->
    <mxCell id="uc_adm_draw" value="Vẽ mới &amp; chỉnh sửa&#xa;đối tượng bản đồ GeoJSON" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontColor=#111827;fontSize=11.5;fontFamily=Helvetica;" vertex="1" parent="zone_admin">
      <mxGeometry x="85" y="255" width="205" height="52" as="geometry"/>
    </mxCell>

    <!-- Luu ban do Atomic -->
    <mxCell id="uc_adm_save" value="Lưu bản đồ số an toàn&#xa;(Atomic Write POST /api/save)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontColor=#111827;fontSize=11.5;fontFamily=Helvetica;" vertex="1" parent="zone_admin">
      <mxGeometry x="80" y="330" width="215" height="52" as="geometry"/>
    </mxCell>

    <!-- Validate GeoJSON -->
    <mxCell id="uc_adm_validate" value="Kiểm tra hợp lệ cấu trúc&#xa;(Validate FeatureCollection)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=1.5;stroke-dasharray=4,2;fontColor=#111827;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="zone_admin">
      <mxGeometry x="85" y="405" width="205" height="50" as="geometry"/>
    </mxCell>

    <!-- Backup & Checksum -->
    <mxCell id="uc_adm_backup" value="Tự động sao lưu &amp; tạo Checksum&#xa;(Auto Backup &amp; Recovery)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=1.5;stroke-dasharray=4,2;fontColor=#111827;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="zone_admin">
      <mxGeometry x="80" y="475" width="215" height="52" as="geometry"/>
    </mxCell>

    <!-- Cap nhat bien dong dan cu -->
    <mxCell id="uc_adm_residents" value="Cập nhật biến động nhân khẩu,&#xa;thêm / xóa / sửa hộ dân" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontColor=#111827;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="zone_admin">
      <mxGeometry x="85" y="550" width="205" height="52" as="geometry"/>
    </mxCell>

    <!-- Xuat bao cao thong ke -->
    <mxCell id="uc_adm_export" value="Xuất file báo cáo số liệu&#xa;(Excel, GeoJSON, PDF)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111827;strokeWidth=1.5;fontColor=#111827;fontSize=11.5;fontFamily=Helvetica;" vertex="1" parent="zone_admin">
      <mxGeometry x="90" y="625" width="195" height="50" as="geometry"/>
    </mxCell>


    <!-- ASSOCIATIONS FROM USER (Left Actor) -> Only 4 public Use Cases -->
    <mxCell id="e_u1" value="" style="endArrow=none;html=1;strokeColor=#111827;strokeWidth=1.3;" edge="1" source="actor_user" target="uc_pub_map" parent="1">
