        <mxCell id="edge_submit_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="node_submit" target="node_end" parent="1">
          <mxGeometry relative="1" as="geometry" />
