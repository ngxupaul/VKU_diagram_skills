  <diagram id="p3_webgis_activity" name="3. Activity Diagram Lưu GeoJSON (Hình 1 - Mục 3.2)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="920">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- SWIMLANES (Grayscale: White/Light Gray, Black borders) -->
    <!-- Lane 1: Nguoi dung -->
    <mxCell id="lane_user" value="1. Người dùng (Cán bộ / Sinh viên)" style="swimlane;startSize=34;fillColor=#F3F4F6;strokeColor=#374151;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#111827;align=center;collapsible=0;html=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="30" width="250" height="840" as="geometry"/>
    </mxCell>

    <!-- Lane 2: Client WebGIS -->
    <mxCell id="lane_client" value="2. Trình duyệt (WebGIS &amp; Dashboard)" style="swimlane;startSize=34;fillColor=#FFFFFF;strokeColor=#374151;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#111827;align=center;collapsible=0;html=1;" vertex="1" parent="1">
      <mxGeometry x="290" y="30" width="260" height="840" as="geometry"/>
    </mxCell>

    <!-- Lane 3: Server Python -->
