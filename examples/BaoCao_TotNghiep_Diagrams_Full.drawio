          <mxGeometry x="320" y="125" width="160" height="52" as="geometry" />
        </mxCell>

        <!-- Edge 1: Start -> Login to System (Red Arrow as shown in screenshot) -->
        <mxCell id="edge_start_login" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" source="node_start" target="node_login" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. Action: Select Team -->
