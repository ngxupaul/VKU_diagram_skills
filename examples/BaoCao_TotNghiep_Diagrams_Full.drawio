        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 1. Initial State (Start Node) -->
        <mxCell id="node_start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;html=1;" vertex="1" parent="1">
          <mxGeometry x="386" y="50" width="28" height="28" as="geometry" />
        </mxCell>

        <!-- 2. Action: Login to System -->
